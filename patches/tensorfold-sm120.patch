diff --git a/zig/src/families/glm_moe_dsa/cuda_prefill_exchange.zig b/zig/src/families/glm_moe_dsa/cuda_prefill_exchange.zig
new file mode 100644
index 0000000000000000000000000000000000000000..f462b437dec81669a128775018013fedb4f31c1c
--- /dev/null
+++ b/zig/src/families/glm_moe_dsa/cuda_prefill_exchange.zig
@@ -0,0 +1,115 @@
+const std = @import("std");
+const cuda = @import("cuda");
+const kern = @import("cuda_kernels.zig");
+
+const world = 4;
+const hidden = 6144;
+const max_part = 8192 * hidden / (2 * world);
+const Handle = extern struct { data: [64]u8 };
+const GetHandle = *const fn (*Handle, u64) callconv(.c) c_int;
+const OpenHandle = *const fn (*u64, Handle, c_uint) callconv(.c) c_int;
+const CloseHandle = *const fn (u64) callconv(.c) c_int;
+
+pub const Exchange = struct {
+    d: *const cuda.Driver,
+    inbox: cuda.DeviceBuffer,
+    marks: cuda.DeviceBuffer,
+    peers: [world]u64,
+    closeHandle: CloseHandle,
+    rank: usize,
+
+    pub fn init(d: *cuda.Driver, rdv: *cuda.rendezvous.Rendezvous, rank: usize) !Exchange {
+        const get = d.lib.lookup(GetHandle, "cuIpcGetMemHandle") orelse return error.MissingSymbol;
+        const open = d.lib.lookup(OpenHandle, "cuIpcOpenMemHandle_v2") orelse return error.MissingSymbol;
+        const close = d.lib.lookup(CloseHandle, "cuIpcCloseMemHandle") orelse return error.MissingSymbol;
+        var inbox = try cuda.DeviceBuffer.alloc(d, 2 * world * max_part * 2);
+        errdefer inbox.free();
+        var marks = try cuda.DeviceBuffer.alloc(d, (world + 1) * 4);
+        errdefer marks.free();
+        try marks.fill8(0, null);
+        var mine: Handle = undefined;
+        try d.check(get(&mine, inbox.ptr), "cuIpcGetMemHandle");
+        var handles: [world]Handle = undefined;
+        try rdv.allGather(std.mem.asBytes(&mine), std.mem.asBytes(&handles));
+        var peers: [world]u64 = @splat(0);
+        errdefer for (peers, 0..) |ptr, i| {
+            if (i != rank and ptr != 0) _ = close(ptr);
+        };
+        peers[rank] = inbox.ptr;
+        for (handles, 0..) |handle, i| {
+            if (i == rank) continue;
+            try d.check(open(&peers[i], handle, 1), "cuIpcOpenMemHandle");
+        }
+        return .{ .d = d, .inbox = inbox, .marks = marks, .peers = peers, .closeHandle = close, .rank = rank };
+    }
+
+    pub fn deinit(e: *Exchange) void {
+        for (e.peers, 0..) |ptr, i| {
+            if (i != e.rank) _ = e.closeHandle(ptr);
+        }
+        e.marks.free();
+        e.inbox.free();
+    }
+
+    pub fn supports(rows: usize, width: usize) bool {
+        return width == hidden and (rows == 4096 or rows == 8192);
+    }
+
+    pub fn reduce(e: *const Exchange, o: kern.Ops, comm: *const cuda.nccl.Communicator, input: u64, output: u64, rows: usize, half: usize) !void {
+        const half_rows = rows / 2;
+        const begin = if (half == 0) 0 else half_rows;
+        const count = (if (half == 0) half_rows else rows - half_rows) * hidden;
+        const part = ((count / hidden + world - 1) / world) * hidden;
+        const slot = half * world * max_part * 2;
+        const offset = slot + e.rank * part * 2;
+        for (0..world) |j| {
+            const peer = (e.rank + j) % world;
+            const words = @min(part, count -| (peer * part));
+            if (words > 0)
+                try e.d.check(e.d.api.cuMemcpyDtoDAsync_v2(e.peers[peer] + offset, input + peer * part * 2, words * 2, o.s.handle), "prefill peer copy");
+        }
+        // The barrier orders all writes before local reads. Two slots keep each
+        // input live until all ranks have passed the barrier for the other slot.
+        try comm.allGather(e.marks.ptr, e.marks.ptr + 4, 1, .i32, o.s.handle);
+        const first = e.rank * part;
+        const words = @min(part, count -| first);
+        if (words > 0) try o.prefillRingSum(e.inbox.ptr + slot, output, part, words, begin * hidden + first, rows * hidden);
+    }
+
+    pub fn verify(e: *const Exchange, gpa: std.mem.Allocator, o: kern.Ops, comm: *const cuda.nccl.Communicator) !bool {
+        var source = try cuda.DeviceBuffer.alloc(e.d, 8192 * hidden * 2);
+        defer source.free();
+        var reference = try cuda.DeviceBuffer.alloc(e.d, source.len);
+        defer reference.free();
+        var reduced = try cuda.DeviceBuffer.alloc(e.d, 2 * max_part * 2);
+        defer reduced.free();
+        const check = try gpa.alloc(u8, 2 * max_part * 2);
+        defer gpa.free(check);
+        const expected = try gpa.alloc(u8, check.len);
+        defer gpa.free(expected);
+        var exact = true;
+        for ([_]usize{ 2048, 2049, 3077, 4001, 4095, 4096, 4097, 5001, 7726, 8191, 8192 }) |rows| {
+            const count = rows * hidden;
+            try o.prefillRingProbe(source.ptr, count, e.rank);
+            try comm.allReduce(source.ptr, reference.ptr, count, .bf16, .sum, o.s.handle);
+            for (0..2) |half| {
+                try e.reduce(o, comm, source.ptr + half * (rows / 2) * hidden * 2, reduced.ptr + half * max_part * 2, rows, half);
+            }
+            try o.s.synchronize();
+            for (0..2) |half| {
+                const begin = half * (rows / 2);
+                const count_rows = if (half == 0) rows / 2 else rows - rows / 2;
+                const part = (count_rows + world - 1) / world;
+                const first = e.rank * part;
+                const bytes = @min(part, count_rows -| first) * hidden * 2;
+                try reduced.download(half * max_part * 2, check[0..bytes]);
+                try reference.download((begin + first) * hidden * 2, expected[0..bytes]);
+                if (!std.mem.eql(u8, check[0..bytes], expected[0..bytes])) {
+                    std.log.warn("prefill owner exchange disagrees with NCCL at {d} rows, half {d}, rank {d}", .{ rows, half, e.rank });
+                    exact = false;
+                }
+            }
+        }
+        return exact;
+    }
+};
