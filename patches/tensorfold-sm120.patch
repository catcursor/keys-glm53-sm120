+const KvRange = struct {
+    base: usize = 0,
+    rows: usize = 0,
+    tokens: usize = 0,
+
+    fn overlaps(a: KvRange, b: KvRange) bool {
+        return a.rows != 0 and b.rows != 0 and a.base < b.base + b.rows and b.base < a.base + a.rows;
+    }
