index 9a9c21743bb480c34c7762da4b9ddc7c62544710..ddc1b826e21e201955475262395ea23301346b14 100644
--- a/zig/kernels/cuda/glm53_prompt.cu
+++ b/zig/kernels/cuda/glm53_prompt.cu
@@ -30,3 +30,38 @@ extern "C" __global__ void glm53_hadamard(__nv_bfloat16* __restrict__ out) {
     const int i = blockIdx.x, j = threadIdx.x;
     out[i * 128 + j] = __float2bfloat16_rn((__popc(i & j) & 1) ? -1.0f : 1.0f);
 }
+
+extern "C" __global__ void glm53_prefill_ring_sum(
+    const __nv_bfloat162* __restrict__ input, __nv_bfloat162* __restrict__ output,
+    int part, int count, int begin, int total) {
+    const int i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= count) return;
+    // BF16 pairs per NCCL Simple Ring chunk and channel partition.
+    constexpr int stripe = 1048576 / 2;
+    constexpr int cell = 8192 / 2;
+    const int channel = ((total + 4 * cell - 1) / (4 * cell)) * cell;
+    const int index = begin + i;
+    const int base = (index / channel) * channel;
+    const int channel_count = min(channel, total - base);
+    const int within = index - base;
+    const int offset = within / (4 * stripe) * (4 * stripe);
+    const int tail = ((channel_count - offset + 15) / 16) * 4;
+    const int owner = (within - offset) / min(stripe, tail);
+    const auto a = input[((owner + 1) % 4) * part + i];
+    const auto b = input[((owner + 2) % 4) * part + i];
+    const auto c = input[((owner + 3) % 4) * part + i];
+    const auto d = input[owner * part + i];
+    output[i] = __hadd2(__hadd2(__hadd2(a, b), c), d);
+}
+
+extern "C" __global__ void glm53_prefill_ring_probe(__nv_bfloat16* output, int n, int rank) {
+    const int i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= n) return;
+    uint32_t value = uint32_t(i) ^ (uint32_t(rank + 1) * 0x9e3779b9u);
+    value ^= value >> 16;
+    value *= 0x7feb352du;
+    value ^= value >> 15;
+    value *= 0x846ca68bu;
+    value ^= value >> 16;
+    output[i] = __float2bfloat16_rn(float(int(value % 4001u) - 2000) / 997.0f);
+}
