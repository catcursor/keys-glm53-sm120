+//! LMCache's lm:// remote server protocol, used with TensorFold's own state format.
+const std = @import("std");
+const posix = std.posix;
+
+const chunk_bytes = 4 << 20;
+const key_bytes = 150;
+const header_bytes = 36;
+const binary_buffer = 5;
+const uint8_dtype = 6;
+const success = 200;
+const Command = enum(u32) { put = 1, get = 2, exists = 3 };
+
+pub const StateStream = struct {
+    gpa: std.mem.Allocator,
+    fd: c_int,
+    buf: []u8,
+    total: usize,
+    identity: u64,
+    world: usize,
+    rank: usize,
+    digest: [64]u8,
+    written: usize = 0,
+    loaded: ?usize = null,
+
+    pub fn connect(gpa: std.mem.Allocator, port: u16, ids: []const u32, total: usize, identity: u64, world: usize, rank: usize) !StateStream {
+        if (total == 0) return error.BadCacheSize;
+        const fd = std.c.socket(posix.AF.INET, posix.SOCK.STREAM | posix.SOCK.CLOEXEC, 0);
+        if (fd < 0) return error.CacheConnect;
+        errdefer _ = std.c.close(fd);
+        const timeout: extern struct { seconds: c_long, micros: c_long } = .{ .seconds = 5, .micros = 0 };
+        try posix.setsockopt(fd, posix.SOL.SOCKET, posix.SO.SNDTIMEO, std.mem.asBytes(&timeout));
+        try posix.setsockopt(fd, posix.SOL.SOCKET, posix.SO.RCVTIMEO, std.mem.asBytes(&timeout));
+        const addr: posix.sockaddr.in = .{
+            .family = posix.AF.INET,
+            .port = std.mem.nativeToBig(u16, port),
+            .addr = std.mem.nativeToBig(u32, 0x7f000001),
+        };
+        if (posix.errno(posix.system.connect(fd, @ptrCast(&addr), @sizeOf(posix.sockaddr.in))) != .SUCCESS)
+            return error.CacheConnect;
+        var hash: [32]u8 = undefined;
+        std.crypto.hash.sha2.Sha256.hash(std.mem.sliceAsBytes(ids), &hash, .{});
+        return .{
+            .gpa = gpa, .fd = fd, .buf = try gpa.alloc(u8, @min(total, chunk_bytes)),
+            .total = total, .identity = identity, .world = world, .rank = rank,
+            .digest = std.fmt.bytesToHex(hash, .lower),
+        };
+    }
+
+    pub fn close(s: *StateStream) void {
+        _ = std.c.close(s.fd);
+        s.gpa.free(s.buf);
+    }
+
+    fn sendAll(s: *const StateStream, data: []const u8) !void {
+        var off: usize = 0;
+        while (off < data.len) {
+            const n = std.c.send(s.fd, data[off..].ptr, data.len - off, posix.MSG.NOSIGNAL);
+            if (n <= 0) return error.CacheWrite;
+            off += @intCast(n);
+        }
+    }
+
+    fn recvAll(s: *const StateStream, data: []u8) !void {
+        var off: usize = 0;
+        while (off < data.len) {
+            const n = posix.read(s.fd, data[off..]) catch return error.CacheRead;
+            if (n == 0) return error.CacheRead;
+            off += n;
+        }
+    }
+
+    fn request(s: *const StateStream, command: Command, page: usize, len: usize) !void {
+        var header: [header_bytes + key_bytes]u8 = @splat(0);
+        const values = [_]u32{ @intFromEnum(command), @intCast(len), binary_buffer, uint8_dtype, 0, @intCast(len), 0, 0, 0 };
+        for (values, 0..) |v, i| std.mem.writeInt(u32, header[i * 4 ..][0..4], v, .little);
+        const key = header[header_bytes..];
+        @memset(key, ' ');
+        _ = try std.fmt.bufPrint(key, "tf-glm53-v1-{x:0>16}@{d}@{d}@{s}{x:0>8}@uint8", .{
+            s.identity, s.world, s.rank, &s.digest, page,
+        });
+        try s.sendAll(&header);
+    }
+
+    fn reply(s: *const StateStream, len: usize) !void {
+        var header: [header_bytes]u8 = undefined;
+        try s.recvAll(&header);
+        switch (std.mem.readInt(u32, header[0..4], .little)) {
+            success => {},
+            400 => return error.CacheMiss,
+            else => return error.CacheProtocol,
+        }
+        if (std.mem.readInt(u32, header[4..8], .little) != len) return error.CacheProtocol;
+        if (len != 0 and (std.mem.readInt(u32, header[8..12], .little) != binary_buffer or
+            std.mem.readInt(u32, header[12..16], .little) != uint8_dtype)) return error.CacheProtocol;
+    }
+
+    pub fn writeAll(s: *StateStream, data: []const u8) !void {
+        if (data.len > s.total - s.written) return error.BadCacheSize;
+        var off: usize = 0;
+        while (off < data.len) {
+            const page = s.written / chunk_bytes;
+            const start = page * chunk_bytes;
+            const size = @min(chunk_bytes, s.total - start);
+            const index = s.written - start;
+            const n = @min(data.len - off, size - index);
+            @memcpy(s.buf[index..][0..n], data[off..][0..n]);
+            off += n;
+            s.written += n;
+            if (index + n == size) {
+                try s.request(.put, page, size);
+                try s.sendAll(s.buf[0..size]);
+                try s.request(.exists, page, 0);
+                try s.reply(0);
+            }
+        }
+    }
+
+    pub fn finish(s: *const StateStream) !void {
+        if (s.written != s.total) return error.BadCacheSize;
+    }
+
+    pub fn readAt(s: *StateStream, data: []u8, offset: u64) !void {
+        if (offset > s.total or data.len > s.total - offset) return error.BadCacheSize;
+        var off: usize = 0;
+        while (off < data.len) {
+            const pos: usize = @as(usize, @intCast(offset)) + off;
+            const page = pos / chunk_bytes;
+            const start = page * chunk_bytes;
+            const size = @min(chunk_bytes, s.total - start);
+            if (s.loaded != page) {
+                try s.request(.get, page, 0);
+                try s.reply(size);
+                try s.recvAll(s.buf[0..size]);
+                s.loaded = page;
+            }
+            const index = pos - start;
+            const n = @min(data.len - off, size - index);
+            @memcpy(data[off..][0..n], s.buf[index..][0..n]);
+            off += n;
+        }
+    }
+};
