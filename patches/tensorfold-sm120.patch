+fn firstGap(ranges: []const KvRange, busy: []const bool, capacity: usize, rows: usize) ?usize {
+    var span: KvRange = .{ .rows = rows };
+    while (span.base + rows <= capacity) {
+        const start = span.base;
+        for (ranges, busy) |r, active| {
+            if (active and span.overlaps(r)) span.base = r.base + r.rows;
+        }
