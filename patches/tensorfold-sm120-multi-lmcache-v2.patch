+    fn cacheRingBytes(mu: *const Multi, n: usize, mode: Mode) usize {
+        return if (mu.mdOf(mode)) |x| x.windowBytes(n) else 0;
+    }
+
+    pub fn cacheStateBytes(mu: *Multi, n: usize, mode: Mode) !u64 {
+        const vs = try rz.rowViews(mu.gpa, &mu.r.st, mu.w.config, n, mu.r.set.dcp);
+        defer mu.gpa.free(vs);
+        var total: u64 = @sizeOf(CacheHead) + vs.len * 16 + mu.D * 2 + mu.V * 4 + mu.cacheRingBytes(n, mode);
+        for (vs) |v| total += v.row * v.rows;
+        return total;
+    }
