+test "function index preserves catalog order, specialization and ambiguity without caching runtime values" {
+    const gpa = std.testing.allocator;
+    const parsed = try parseTestSet();
+    defer parsed.deinit();
+    var other_consts: std.json.ArrayHashMap(ConstJson) = .{};
+    defer other_consts.map.deinit(gpa);
+    try other_consts.map.put(gpa, "CHK", .{ .int = 512 });
+    try other_consts.map.put(gpa, "SCALE", .{ .f32 = 1031798784 });
+    const unaligned_params = [_]ParamJson{
+        .{ .name = "Q", .type = "*bf16", .div16 = false, .nospec = false },
+        .{ .name = "R", .type = "i32", .div16 = true, .nospec = false },
+    };
+    const aligned_params = [_]ParamJson{
+        .{ .name = "Q", .type = "*bf16", .div16 = true, .nospec = false },
+        .{ .name = "R", .type = "i32", .div16 = true, .nospec = false },
+    };
+    var specs: [9]KernelJson = undefined;
+    @memcpy(specs[0..5], parsed.value.kernels);
+    for (5..specs.len) |i| specs[i] = specs[0];
+    // A duplicate after another function must still select the original index 0.
+    specs[6].params = @constCast(&unaligned_params);
+    specs[7].params = @constCast(&aligned_params);
+    specs[8].consts = other_consts;
+    var index = try FunctionIndex.init(gpa, &specs);
+    defer index.deinit(gpa);
+    try std.testing.expectEqualSlices(usize, &.{ 0, 1, 2, 3, 5, 6, 7, 8 }, index.by_name.get("_attn").?.items);
+    try std.testing.expectEqualSlices(usize, &.{4}, index.by_name.get("_norm").?.items);
+
+    const opts = [_]Launch{ .{}, .{ .num_warps = 4 }, .{ .num_warps = 8 }, .{ .num_warps = 4, .num_stages = 2 }, .{ .num_warps = 8, .num_stages = 1 }, .{ .num_warps = 4, .num_stages = 3 } };
+    for ([_]u64{ 0x1000, 0x2000, 0x1008, 0x2008 }) |address| {
+        for ([_]i32{ 1, 3, 5, 16, 32 }) |rows| {
+            const args = [_]Arg{ ptr("Q", "*bf16", address), int("R", rows) };
+            for ([_]i64{ 256, 512, 2048 }) |chk| {
+                const consts = [_]Const{ ci("CHK", chk), cf("SCALE", 0.0625) };
+                for (opts) |o| try expectIndexedPick(&index, &specs, "_attn", &args, &consts, o);
+            }
+        }
+    }
+    const args = [_]Arg{ ptr("Q", "*bf16", 0x1000), int("R", 3) };
+    const consts = [_]Const{ ci("CHK", 256), cf("SCALE", 0.0625) };
+    try std.testing.expectEqual(@as(usize, 0), try index.pick(&specs, "_attn", &args, &consts, .{ .num_warps = 4, .num_stages = 2 }));
+    try std.testing.expectError(error.AmbiguousTritonVariant, index.pick(&specs, "_attn", &args, &consts, .{}));
+    const wrong_scale = [_]Const{ ci("CHK", 256), cf("SCALE", 0.125) };
+    try expectIndexedPick(&index, &specs, "_attn", &args, &wrong_scale, .{});
+    const x = [_]Arg{ptr("X", "*bf16", 0x2000)};
+    const d = [_]Const{ci("D", 6144)};
+    for (opts) |o| {
+        try expectIndexedPick(&index, &specs, "_norm", &x, &d, o);
+        try expectIndexedPick(&index, &specs, "_nope", &x, &d, o);
+    }
+}
+
+test "function index releases partial lists when any allocation fails" {
+    const parsed = try parseTestSet();
+    defer parsed.deinit();
+    const Case = struct {
+        fn run(gpa: std.mem.Allocator, specs: []const KernelJson) !void {
+            var index = try FunctionIndex.init(gpa, specs);
+            defer index.deinit(gpa);
+            try std.testing.expectEqual(@as(usize, 2), index.by_name.count());
+        }
+    };
+    try std.testing.checkAllAllocationFailures(std.testing.allocator, Case.run, .{parsed.value.kernels});
+}
