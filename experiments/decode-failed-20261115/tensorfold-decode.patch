+/// Built once from the immutable catalog. Names borrow the parsed catalog's storage;
+/// each list keeps its original order so duplicate and ambiguous matches are unchanged.
+const FunctionIndex = struct {
+    by_name: std.StringHashMapUnmanaged(std.ArrayList(usize)) = .empty,
+
+    fn init(gpa: std.mem.Allocator, specs: []const KernelJson) !FunctionIndex {
+        var index: FunctionIndex = .{};
+        errdefer index.deinit(gpa);
+        for (specs, 0..) |k, i| {
+            const entry = try index.by_name.getOrPut(gpa, k.@"fn");
+            if (!entry.found_existing) entry.value_ptr.* = .empty;
+            try entry.value_ptr.append(gpa, i);
+        }
+        return index;
+    }
+
+    fn deinit(index: *FunctionIndex, gpa: std.mem.Allocator) void {
+        var values = index.by_name.valueIterator();
+        while (values.next()) |indices| indices.deinit(gpa);
+        index.by_name.deinit(gpa);
+        index.* = .{};
+    }
+
+    fn pick(index: *const FunctionIndex, specs: []const KernelJson, function: []const u8, args: []const Arg, consts: []const Const, opts: Launch) PickError!usize {
+        const indices = index.by_name.get(function) orelse return error.MissingTritonVariant;
+        var found: ?usize = null;
+        for (indices.items) |i| {
+            const k = specs[i];
+            if (!opts.admits(k) or !matches(k, args, consts)) continue;
+            if (found) |f| {
+                const a = specs[f];
+                if (a.num_warps != k.num_warps or a.num_stages != k.num_stages) return error.AmbiguousTritonVariant;
+                continue;
+            }
+            found = i;
+        }
+        return found orelse error.MissingTritonVariant;
+    }
+};
